generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id                      String   @id @default(uuid())
  submissionCode          String   @unique @map("submission_code")
  name                    String
  whatsapp                String   @unique
  email                   String   @unique
  ktpFilePath             String   @map("ktp_file_path")
  logoVectorFilePath      String   @map("logo_vector_file_path")
  logoPngFilePath         String   @map("logo_png_file_path")
  logoJpegFilePath        String   @map("logo_jpeg_file_path")
  filosofiPdfFilePath     String   @map("filosofi_pdf_file_path")
  suratPernyataanFilePath String   @map("surat_pernyataan_file_path")
  title                   String
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([whatsapp])
  @@index([submissionCode])
  @@map("submissions")
}
